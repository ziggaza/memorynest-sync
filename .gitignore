# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/

# ── Virtual envs ──────────────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── PyInstaller build artifacts ───────────────────────────────────────────────
build/
dist/
*.spec
*.spec.bak

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Runtime / user data ───────────────────────────────────────────────────────
settings.json
.organizer/
# Per-user runtime config (live data); the factory defaults committed to
# git are in config.default.json. Each install copies that to the user
# data dir as config.json on first run.
config.json
# Sound cache — regenerated on first launch from numpy synth
sounds/
assets/sounds/

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Claude session state ──────────────────────────────────────────────────────
.claude/settings.local.json

# ── OS ────────────────────────────────────────────────────────────────────────
desktop.ini
installer_output/
